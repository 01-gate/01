# NanoGPT inference API. Используется только для моделей и chat completions.
NANOGPT_INFERENCE_BASE_URL=https://api.nano-gpt.com/v1
NANOGPT_API_KEY=replace_with_private_nanogpt_inference_key

# Клиентский ключ локального gateway. Это не ключ NanoGPT.
GATEWAY_TEST_API_KEY=replace_with_local_gateway_client_key

# Отдельная граница будущих Usage / Request Billing вызовов.
# На этом срезе не используется и не инициирует сетевые запросы.
NANOGPT_USAGE_BASE_URL=https://api.nano-gpt.com/api/v1

# Необязательные настройки. Значения ниже — боевые рекомендации.
NANOGPT_TIMEOUT_SECONDS=90
# Источник генерации: nanogpt (реальный upstream) | stub (только тесты/разработка).
# Для боя обязательно nanogpt; в коде default остаётся stub для тестов.
GATEWAY_UPSTREAM=nanogpt
# INFO: две строки chat/tokens; DEBUG: плюс SSE-диагностика.
LOG_LEVEL=INFO

# In-process лимиты gateway (не распределённые). 0 в rate-limit = выключен.
GATEWAY_MAX_CONCURRENT_CHAT=8
GATEWAY_RATE_LIMIT_REQUESTS=0
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60

# Журнал запросов (JSONL, без секретов и промптов).
# На сервере лучше абсолютный путь вне каталога деплоя.
GATEWAY_REQUEST_LOG_PATH=data/request_log.jsonl

# Публичная модель для тестов и smoke-скриптов.
GATEWAY_TEST_MODEL=deepseek