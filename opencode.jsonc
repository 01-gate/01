{
  "$schema": "https://opencode.ai/config.json",
  "model": "zer0ne/deepseek",
  "provider": {
    "zer0ne": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "0ne",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "huy-v-jope"
      },
      "models": {
        "mimo": {
          "name": "04 Mimo",
          "description": "Дёшево, но медленно и туговато",
          "options": {
            "reasoningEffort": "high"
          },
          "limit": { "context": 333333, "output": 8192 },
          "cost": { "input": 12, "output": 0.23, "cache_read": 0.23, "cache_write": 0 },
          "variants": {
            "high": { "reasoningEffort": "high" },
            "none": { "reasoningEffort": "none" }
          }
        },
        "deepseek": {
          "name": "01 DeepSeek",
          "description": "Лучший баланс цены и качества без но",
          "options": {
            "reasoningEffort": "low"
          },
          "limit": { "context": 333333, "output": 8192 },
          "cost": { "input": 10, "output": 40, "cache_read": 0.5, "cache_write": 0 },
          "variants": {
            "max": { "reasoningEffort": "max" },
            "high": { "reasoningEffort": "high" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        },
        "glm": {
          "name": "03 GLM",
          "description": "Лучший баланс цены и качества без но",
          "limit": {
            "context": 333333,
            "output": 8192
          },
          "cost": { "input": 7.5, "output": 25, "cache_read": 2.5, "cache_write": 0 }
        },
        "spark": {
          "name": "02 Muse Spark",
          "description": "Круче просто не найти, но Meta следит",
          "limit": {
            "context": 333333,
            "output": 8192
          },
          "cost": { "input": 7.5, "output": 17.5, "cache_read": 0.175, "cache_write": 0 }
        },
        "qwen": {
          "name": "05 Qwen",
          "description": "Лучший баланс цены и качества без но",
          "limit": {
            "context": 333333,
            "output": 8192
          },
          "cost": { "input": 12.5, "output": 35, "cache_read": 1.75, "cache_write": 17.5 }
        }
      }
    }
  }
}
